{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "github-actions", "dockerfile"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^compose\\.ya?ml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+versioning=(?<versioning>\\S+)\\s+image:[^\\n]*:(?<currentValue>[\\d.]+)\\}"
      ]
    }
  ]
}
