#!/bin/bash
#
# This script fires up a two-server IRC network and runs the test framework
#

# Exit on error:
set -e

# Verbose:
set -x

# Kill old instances
killall -9 obbyircd || true

# Install 'unrealircd-tests'
rm -rf unrealircd-tests/
git clone -q --branch unreal60 https://github.com/unrealircd/unrealircd-tests.git unrealircd-tests
cd unrealircd-tests

# The upstream test harness boots the server via 'bin/unrealircd' and reads
# 'data/unrealircd.pid'. ObbyIRCd renamed the binary/pidfile to obbyircd, so
# adapt the freshly-cloned run script to our names (leaves serverconfig paths
# untouched).
sed -i 's@bin/unrealircd @bin/obbyircd @g; s@unrealircd\.pid@obbyircd.pid@g' run

# ObbyIRCd loads account-registration with RTLD_GLOBAL (so account-recovery can
# share its DB layer). Under ASAN that exposes per-module 'Mod_Header' globals
# in the global namespace, which the cross-DSO ODR checker false-positives on.
# Disable that one check (the modules are genuinely distinct objects).
sed -i 's@^export ASAN_OPTIONS=.*@&:detect_odr_violation=0@' run

# The upstream tests below assert behaviour that depends on obbyircd-specific
# choices, not on portable IRC semantics. Drop them so CI tracks real
# regressions rather than known divergence.
#
#  Permissions (member-roles, config-gated): upstream assumes 'an op can voice
#  / op / -o anyone, NAMES shows + for voiced'. In obbyircd, prefix-mode
#  ability is per-role via can_set/can_unset in member-roles.conf, so these
#  tests are really testing the shipped role config rather than obbyircd.
#
#  Rebranding/install state: VERSION/CREDITS strings, the 3rd-party MODULE
#  listing -- obbyircd intentionally differs from upstream here.
#
#  +t flag (already covered above): obbyircd has no +t flag; can_topic is
#  enforced per-role unconditionally.
for t in \
	chanmodes/topiclimit \
	chanmodes/delayjoin \
	chanmodes/vhoaq \
	extensions/multi-prefix \
	usercommands/names \
	usercommands/invite \
	usercommands/version \
	usercommands/credits \
	usercommands/module
do
	rm -f "tests/$t"
done

# FreeBSD has various issues with the tests from us and others,
# better set a flag to keep it simple:
if uname -a|grep -q FreeBSD; then
	NOSERVICES=1
fi

# Run the test framework, testing both services:
if [ "$NOSERVICES" = 1 ]; then
	./run -services none $RUNTESTFLAGS || exit 1
else
	# Linux tests both with anope and atheme services:
	./run -services anope $RUNTESTFLAGS || exit 1
	./run -services atheme $RUNTESTFLAGS || exit 1
fi

# Database writing/reading tests
## unencrypted:
./run -services none -boot tests/db/writing/* || exit 1
./run -services none -keepdbs -boot tests/db/reading/* || exit 1
## encrypted:
./run -services none -include db_crypted.conf -boot tests/db/writing/* || exit 1
./run -services none -include db_crypted.conf -keepdbs -boot tests/db/reading/* || exit 1

echo "If you also want to run the SSL/TLS tests, see extras/tests/tls/tls-tests"
