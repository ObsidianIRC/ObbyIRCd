[Unit]
Description=ObbyIRCd weather pushbot
After=obbyircd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valware
Group=valware
WorkingDirectory=/home/valware/weatherbot
Environment=PUSHBOT_HOST=127.0.0.1
Environment=PUSHBOT_PORT=6670
Environment=PUSHBOT_TOKEN=replace-me-with-a-long-random-string
Environment=PUSHBOT_NICK=weather
Environment=PUSHBOT_INSECURE=1
ExecStart=/usr/bin/python3 /home/valware/weatherbot/weatherbot.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/weatherbot.log
StandardError=inherit
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
